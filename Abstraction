#include <iostream>
using namespace std;

// Abstract Class (Interface)
class Animal {
public: 
    // Pure virtual function (hides the internal implementation)
    virtual void makeSound() = 0;
};  

// Derived Class provides the actual implementation
class Dog : public Animal {
public:
    void makeSound() {
        cout << "Woof Woof!" << endl;
    }
};

int main() {
    Dog d;
    d.makeSound(); // User only calls the action, implementation is hidden

    return 0;
}
